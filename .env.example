# CareerPilot: AI Career Assistant - Client Environment Configuration
# Copy this file to .env and replace placeholder values with your Supabase credentials.

# Supabase Project URL (found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for frontend client usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Edge Functions base URL (defaults to ${VITE_SUPABASE_URL}/functions/v1)
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-id.supabase.co/functions/v1

# Note: Secret keys like SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY must NEVER be
# in this frontend file. They are set exclusively in the Supabase Dashboard or Edge Function secrets.
